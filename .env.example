# Скопируй в .env и заполни. Файл не коммитить.
# 1) Написать @BotFather в Telegram -> /newbot -> получить токен вида 123456:AA...
# 2) Написать своему боту любое сообщение, затем открыть
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates и взять "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
